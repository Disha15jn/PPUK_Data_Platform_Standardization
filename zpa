data "azurerm_client_config" "current" {}

module "keyvault" {
  for_each = var.key_vaults
  source   = "Azure/avm-res-keyvault-vault/azurerm"
  version  = "0.9.1" 

  name                = each.value.name
  location            = var.common_vars.location
  resource_group_name = module.rg[each.value.resource_group_key].name
  tenant_id           = data.azurerm_client_config.current.tenant_id
  
  sku_name                  = try(each.value.sku_name, "standard")
  enable_telemetry          = var.enable_telemetry
  
  # AVM recommends RBAC for modern DPX platform deployments over access policies
  enable_rbac_authorization       = try(each.value.enable_rbac_authorization, true)
  purge_protection_enabled        = try(each.value.purge_protection_enabled, true)
  public_network_access_enabled   = try(each.value.public_network_access_enabled, false)

  # Network ACLs (Optional: Useful if you need to restrict traffic to specific subnets)
  network_acls = try(each.value.network_acls, null)

  tags = merge(var.common_vars.tags, try(each.value.tags, {}))
}




variable "linux_vms" {
  description = "Map of Linux virtual machine configurations to deploy"
  type = map(object({
    resource_group_key              = string
    vm_name                         = string
    vm_size                         = string
    admin_username                  = string
    
    # Password and Auth Configuration
    generate_ssh_key                = bool
    generate_admin_password         = bool
    admin_password                  = optional(string)
    disable_password_authentication = bool
    key_vault_key                   = optional(string)
    ssh_public_keys                 = optional(list(string), [])

    # Networking Configuration
    subnet_key                      = optional(string)
    existing_vnet_key               = optional(string)
    existing_subnet_key             = optional(string)

    network_interfaces = map(object({
      name                           = optional(string)
      accelerated_networking_enabled = optional(bool, false)
      ip_forwarding_enabled          = optional(bool, false)
      ip_configurations = map(object({
        name                          = optional(string, "internal")
        private_ip_address_allocation = optional(string, "Dynamic")
        private_ip_address            = optional(string)
        public_ip_enabled             = optional(bool, false)
      }))
    }))

    # High Availability
    availability_zone = optional(string)

    # Image Configuration
    source_image_id = optional(string)
    source_image_reference = optional(object({
      publisher = string
      offer     = string
      sku       = string
      version   = string
    }))

    plan = optional(object({
      name      = string
      publisher = string
      product   = string
    }))

    # Disk Configuration
    os_disk = object({
      caching              = string
      storage_account_type = string
      disk_size_gb         = number
    })

    data_disks = optional(map(object({
      caching              = string
      create_option        = string
      disk_size_gb         = number
      lun                  = number
      storage_account_type = string
    })), {})

    # Identity Configuration
    managed_identities = optional(object({
      system_assigned             = optional(bool, true)
      user_assigned_identity_keys = optional(list(string), [])
    }), {})

    # Extensions Configuration
    extensions = optional(object({
      enable_azure_monitor = optional(bool, true)
      enable_aad_login     = optional(bool, true)
    }), {})

    tags = optional(map(string), {})
  }))
  default = {}
}


variable "key_vaults" {
  description = "Map of Key Vault configurations"
  type = map(object({
    name                          = string
    resource_group_key            = string
    sku_name                      = optional(string, "standard")
    enable_rbac_authorization     = optional(bool, true)
    purge_protection_enabled      = optional(bool, true)
    public_network_access_enabled = optional(bool, false)
    
    network_acls = optional(object({
      bypass                     = optional(string, "AzureServices")
      default_action             = optional(string, "Deny")
      ip_rules                   = optional(list(string), [])
      virtual_network_subnet_ids = optional(list(string), [])
    }))
    
    tags = optional(map(string), {})
  }))
  default = {}
}



